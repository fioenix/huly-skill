{
  "name": "huly-skill",
  "version": "1.10.2",
  "type": "module",
  "description": "CLI tool and agent skill for managing tasks, projects, labels, documents, and milestones in Huly",
  "license": "MIT",
  "author": "fioenix",
  "homepage": "https://github.com/fioenix/huly-skill#readme",
  "bugs": {
    "url": "https://github.com/fioenix/huly-skill/issues"
  },
  "main": "bin/bundle.cjs",
  "bin": {
    "huly": "./bin/huly.cjs",
    "huly-mcp": "./bin/mcp.cjs"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:mcp",
    "build:cli": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bin/bundle.cjs --minify --define:import.meta.url='\"file:///bundle\"' --define:__HULY_VERSION__='\"'$npm_package_version'\"'",
    "build:mcp": "esbuild src/mcp/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bin/mcp.cjs --minify --define:import.meta.url='\"file:///bundle\"' --define:__HULY_VERSION__='\"'$npm_package_version'\"' && node -e \"require('fs').copyFileSync('bin/mcp.cjs','npm-package/huly-mcp.cjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:mcp": "node bin/mcp.cjs",
    "verify:release": "node scripts/verify-release.mjs",
    "pack:skill": "node scripts/pack-skill.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "huly",
    "project-management",
    "cli",
    "agent-skill",
    "claude-code",
    "task-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fioenix/huly-skill.git"
  },
  "dependencies": {
    "@hcengineering/activity": "^0.7.423",
    "@hcengineering/api-client": "^0.7.423",
    "@hcengineering/chunter": "^0.7.423",
    "@hcengineering/core": "^0.7.423",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "https-proxy-agent": "^9.1.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
