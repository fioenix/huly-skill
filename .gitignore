# Dependencies
node_modules/

# Build output — tsc intermediate files only, bundle goes to bin/
dist/

# bin/bundle.cjs is committed for zero-install consumers
!bin/bundle.cjs

# npm-package/huly-mcp.cjs is a build-time copy of bin/mcp.cjs —
# regenerated by build:mcp and by the package's prepublishOnly hook.
npm-package/huly-mcp.cjs

# Environment files
.env
.env.local
.env.*.local

# Hidden directories — but not .github, whose workflows must be committed.
# `**/.*/` silently swallowed .github/workflows/ci.yml once: `git add -A` skipped
# it and `git status` stayed clean, so the CI that was supposed to guard this repo
# never existed on main.
**/.*/
!.github/
!.github/**

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Temporary files
*.tmp

# Custom
huly-assist-workspace/
huly-assist.skill