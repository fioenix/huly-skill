# Huly connection — required by both the CLI and the MCP server.
# Copy to ~/.huly/.env (or the project root) and fill in real values.
HULY_HOST=https://huly.app
HULY_WORKSPACE_ID=your-workspace-uuid
HULY_API_KEY=your-api-token

# MCP server — optional.
# Transport: "stdio" (default, for local clients) or "http" (for remote use).
HULY_MCP_TRANSPORT=stdio
# HTTP transport only:
# HULY_MCP_PORT=3000
# Bearer-token guard for the HTTP transport. The server holds Huly
# credentials, so set this for any non-local deployment.
# HULY_MCP_AUTH_TOKEN=your-shared-secret

# Who is operating this CLI, when the token is shared by a team.
# Huly issues tokens per (account, workspace) and its token screen is admin-only,
# so every caller is otherwise the token's owner. HULY_ACTOR names the real one:
# it makes "me" resolve to that person and stamps "Requested by: <name>" onto
# tasks you create. A convention, not authentication — Huly still records the
# token owner as the author, and anyone can set this to any name.
# HULY_ACTOR=Nguyen Van A

# Assignee used when --assignee is omitted. Accepts a name, an _id, or "me".
# HULY_DEFAULT_ASSIGNEE=me
