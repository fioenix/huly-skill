# Huly connection — required by both the CLI and the MCP server.
# Copy to ~/.huly/.env (or the project root) and fill in real values.
HULY_HOST=https://huly.app
HULY_WORKSPACE_ID=your-workspace-uuid
HULY_API_KEY=your-api-token

# MCP server — optional.
# Transport: "stdio" (default, for local clients) or "http" (for remote use).
HULY_MCP_TRANSPORT=stdio
# HTTP transport only:
# HULY_MCP_PORT=3000
# Bearer-token guard for the HTTP transport. The server holds Huly
# credentials, so set this for any non-local deployment.
# HULY_MCP_AUTH_TOKEN=your-shared-secret
